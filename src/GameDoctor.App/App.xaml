<Application x:Class="GameDoctor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameDoctor.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Skin =====
                 Das ERSTE Wörterbuch ist immer der Skin (Farben, Formen, Schriften). ThemeManager tauscht es zur Laufzeit aus.
                 Deshalb werden Skin-Werte überall per DynamicResource eingebunden, nie per StaticResource. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Cyberpunk.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:SeverityBrushConverter x:Key="SeverityBrush"/>
            <local:SeverityLabelConverter x:Key="SeverityLabel"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <local:ShareToStarConverter x:Key="ShareToStar"/>
            <local:FindingTextConverter x:Key="FindingText"/>
            <local:FindingVisibilityConverter x:Key="FindingVisibility"/>
            <local:TechnicalVisibilityConverter x:Key="TechnicalVisibility"/>

            <!-- Karte / Panel in der Form des Skins -->
            <Style x:Key="Card" TargetType="local:ShapeBorder">
                <Setter Property="Background" Value="{DynamicResource Panel}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PanelEdge}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource PanelEdgeThickness}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource ShapeCorner}"/>
                <Setter Property="Chamfer" Value="{DynamicResource ShapeChamfer}"/>
                <Setter Property="EdgeAccent" Value="{DynamicResource EdgeAccent}"/>
            </Style>

            <!-- Kachel mit Kennzahl (Übersicht, Performance) -->
            <DataTemplate x:Key="StatTileTemplate">
                <local:ShapeBorder Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="Bold" FontFamily="{DynamicResource HeadFont}"
                                   Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding Sub}" Margin="0,6,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Sub}"
                                   Visibility="{Binding Sub, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                </local:ShapeBorder>
            </DataTemplate>

            <!-- ===== Grundstile =====
                 Bewusst KEIN impliziter TextBlock-Stil: der würde auch die Texte in Buttons/Tabs überschreiben.
                 Die Textfarbe erbt sich stattdessen vom Fenster. -->
            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource Body}">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="{DynamicResource HeadFont}"/>
            </Style>
            <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource Body}">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="{DynamicResource HeadFont}"/>
                <Setter Property="Margin" Value="0,18,0,8"/>
            </Style>
            <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            </Style>

            <!-- Button -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Background" Value="{DynamicResource PanelHi}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <local:ShapeBorder x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="1" CornerRadius="{DynamicResource ShapeCornerSmall}" Chamfer="{DynamicResource ShapeChamferSmall}"
                                               Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </local:ShapeBorder>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Cyan}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Eingabefelder: dunkel, dünne Kontur, gelber Fokusrahmen -->
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Background" Value="{DynamicResource Bg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource Cyan}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource CornerS}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Background" Value="{DynamicResource Bg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource CornerS}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Kontrollkästchen: Kästchen wird bei Auswahl gelb -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="box" Width="16" Height="16" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                                        Background="{DynamicResource Bg}" CornerRadius="{DynamicResource CornerS}" VerticalAlignment="Center">
                                    <TextBlock x:Name="mark" Text="✓" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Cyan}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Auswahlliste (auch editierbar) -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHi}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="Background" Value="{DynamicResource Bg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderThickness="1" CornerRadius="{DynamicResource CornerS}">
                                                <TextBlock Text="▾" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Cyan}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="cp" IsHitTestVisible="False" Margin="8,6,28,6"
                                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                                         Margin="2,2,26,2" VerticalAlignment="Center" Foreground="{DynamicResource Text}" Padding="6,4"/>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                    <Border MinWidth="{Binding ActualWidth, ElementName=tb}" MaxHeight="260" Background="{DynamicResource Panel}"
                                            BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                                        <ScrollViewer><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="cp" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Zeitraum-Auswahl als Segment-Buttons -->
            <Style x:Key="Segment" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="Transparent" CornerRadius="{DynamicResource CornerS}" Padding="10,5">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHi}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tabs -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{DynamicResource HeadFont}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <!-- Navigation: aktiver Reiter gelb mit dunkler Schrift, inaktive hell auf dunkel -->
                            <Border x:Name="u" Background="Transparent" CornerRadius="{DynamicResource CornerS}" Margin="0,4,6,8" Padding="16,0">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="u" Property="Background" Value="{DynamicResource PanelHi}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="u" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Absturzliste -->
            <Style x:Key="CrashListItem" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <local:ShapeBorder x:Name="b" Background="Transparent" CornerRadius="{DynamicResource ShapeCornerSmall}"
                                               Chamfer="{DynamicResource ShapeChamferSmall}" Padding="10,8" Margin="0,0,0,2">
                                <ContentPresenter/>
                            </local:ShapeBorder>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHi}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHi}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Cyan}"/>
                                    <Setter TargetName="b" Property="BorderThickness" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Schlanke Scrollbar -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Line}" CornerRadius="{DynamicResource CornerS}" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Karte für eine Erkenntnis -->
            <DataTemplate x:Key="FindingTemplate">
                <local:ShapeBorder Style="{StaticResource Card}" Margin="0,0,0,10">
                    <local:ShapeBorder.Visibility>
                        <MultiBinding Converter="{StaticResource FindingVisibility}" ConverterParameter="card">
                            <Binding/>
                            <Binding Path="Expert" Source="{x:Static local:ViewMode.Instance}"/>
                        </MultiBinding>
                    </local:ShapeBorder.Visibility>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Farbleiste links; die Karte schneidet sie auf ihre Form zu -->
                        <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                        <StackPanel Grid.Column="1" Margin="16,12,16,14">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="{DynamicResource CornerS}" Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityLabel}}" Foreground="#111" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{DynamicResource HeadFont}" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource FindingText}" ConverterParameter="title">
                                            <Binding/>
                                            <Binding Path="Expert" Source="{x:Static local:ViewMode.Instance}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSoft}" LineHeight="20" TextWrapping="Wrap">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FindingText}" ConverterParameter="detail">
                                        <Binding/>
                                        <Binding Path="Expert" Source="{x:Static local:ViewMode.Instance}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,6,0,0">
                                <ItemsControl.Visibility>
                                    <MultiBinding Converter="{StaticResource FindingVisibility}" ConverterParameter="evidence">
                                        <Binding/>
                                        <Binding Path="Expert" Source="{x:Static local:ViewMode.Instance}"/>
                                    </MultiBinding>
                                </ItemsControl.Visibility>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{DynamicResource Cyan}" Margin="4,0,8,0"/>
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextSoft}" FontFamily="{DynamicResource MonoFont}" FontSize="12.5" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{DynamicResource RecommendBg}" CornerRadius="{DynamicResource CornerS}" Padding="10,7" Margin="0,10,0,0"
                                    Visibility="{Binding Recommendation, Converter={StaticResource NullToCollapsed}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="➜" Foreground="{DynamicResource Good}" Margin="0,0,8,0" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Recommendation}" Foreground="{DynamicResource RecommendText}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </local:ShapeBorder>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
