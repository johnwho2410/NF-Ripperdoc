<Window x:Class="GameDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameDoctor.App"
        Title="GameDoctor – Cyberpunk 2077"
        Width="1320" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Kopfzeile ===== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,18,28,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Bg}" CornerRadius="6" Padding="3" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="7 Tage" Tag="7" GroupName="days" Checked="Days_Checked"/>
                                <RadioButton Style="{StaticResource Segment}" Content="30 Tage" Tag="30" GroupName="days" IsChecked="True" Checked="Days_Checked"/>
                                <RadioButton Style="{StaticResource Segment}" Content="90 Tage" Tag="90" GroupName="days" Checked="Days_Checked"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Bericht speichern" Margin="0,0,8,0" Click="SaveReport_Click" IsEnabled="{Binding HasResult}"/>
                        <Button Content="Neu analysieren" Style="{StaticResource PrimaryButton}" Click="Analyze_Click" IsEnabled="{Binding IsIdle}"/>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GAME" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="DOCTOR" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Absturzanalyse" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Bottom" Margin="12,0,0,3"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GameInfo}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding FrameworkInfo}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </DockPanel>

                <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,14,0,0" Height="44" VerticalAlignment="Bottom" SelectionChanged="Tabs_SelectionChanged">
                    <TabItem Header="Übersicht"/>
                    <TabItem Header="Abstürze"/>
                    <TabItem Header="Mods &amp; System"/>
                </TabControl>
            </Grid>
        </Border>

        <!-- ===== Inhalt ===== -->
        <Grid Grid.Row="1">

            <!-- Übersicht -->
            <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" Padding="28,22,20,22">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="18,14" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding Sub}" Margin="0,6,0,0" FontFamily="Consolas, Segoe UI" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Sub}"
                                                   Visibility="{Binding Sub, Converter={StaticResource NullToCollapsed}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Das Wichtigste" Style="{StaticResource H2}" Margin="0,26,0,10"/>
                    <ItemsControl ItemsSource="{Binding TopFindings}" ItemTemplate="{StaticResource FindingTemplate}"/>

                    <TextBlock Text="Muster über alle Abstürze" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding PatternFindings}" ItemTemplate="{StaticResource FindingTemplate}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Abstürze -->
            <Grid x:Name="CrashPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <ListBox ItemsSource="{Binding Crashes}" SelectedItem="{Binding SelectedCrash}"
                             Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0" Padding="10"
                             ItemContainerStyle="{StaticResource CrashListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Badge}" Margin="0,4,12,0" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Uptime}" Style="{StaticResource Muted}" FontSize="12"/>
                                            <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource Muted}">
                                            <Run Text="{Binding KindLabel, Mode=OneWay}" Foreground="{StaticResource Cyan}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Label, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,22,20,22"
                              DataContext="{Binding SelectedCrash}"
                              Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ordner öffnen" Click="OpenFolder_Click" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource H1}"/>
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Muted}">
                                    <Run Text="{Binding KindLabel, Mode=OneWay}" Foreground="{StaticResource Cyan}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="18,12" Margin="0,18,0,0">
                            <ItemsControl ItemsSource="{Binding Details}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="Diagnose" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"/>

                        <StackPanel Visibility="{Binding SuspectModules, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="Nicht-Vanilla-Module auf dem Stack" Style="{StaticResource H2}"/>
                            <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="18,12">
                                <ItemsControl ItemsSource="{Binding SuspectModules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas, Segoe UI" Margin="0,3" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                       Text="Rücksprungadressen auf dem Stack des abstürzenden Threads. Ein starkes Indiz für Beteiligung, aber kein Beweis."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Mods & System -->
            <ScrollViewer x:Name="EnvPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22,20,22">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">
                    <TextBlock Text="Mod-Umgebung, Hintergrundfehler und System" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding EnvironmentFindings}" ItemTemplate="{StaticResource FindingTemplate}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Ladeanzeige -->
            <Border Background="#D90E1016" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <TextBlock Text="Analysiere …" Style="{StaticResource H1}" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,12" Foreground="{StaticResource Accent}" Background="{StaticResource PanelHi}" BorderThickness="0"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Statuszeile ===== -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,6">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </Border>
    </Grid>
</Window>
