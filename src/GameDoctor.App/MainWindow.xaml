<Window x:Class="GameDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameDoctor.App"
        Title="GameDoctor – Cyberpunk 2077"
        Width="1320" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Kopfzeile ===== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,18,28,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Bg}" CornerRadius="6" Padding="3" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="7 Tage" Tag="7" GroupName="days" Checked="Days_Checked"/>
                                <RadioButton Style="{StaticResource Segment}" Content="30 Tage" Tag="30" GroupName="days" IsChecked="True" Checked="Days_Checked"/>
                                <RadioButton Style="{StaticResource Segment}" Content="90 Tage" Tag="90" GroupName="days" Checked="Days_Checked"/>
                            </StackPanel>
                        </Border>
                        <Button Content="KI-Auswertung" Margin="0,0,8,0" Click="Prompt_Click" IsEnabled="{Binding HasResult}"
                                ToolTip="Alle Befunde von einer KI auswerten lassen – direkt hier oder per Kopieren in ChatGPT, Claude &amp; Co."/>
                        <Button Content="Bericht speichern" Margin="0,0,8,0" Click="SaveReport_Click" IsEnabled="{Binding HasResult}"/>
                        <Button Content="Neu analysieren" Style="{StaticResource PrimaryButton}" Click="Analyze_Click" IsEnabled="{Binding IsIdle}"/>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="GAME" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="DOCTOR" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Absturz- und Performance-Analyse" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Bottom" Margin="12,0,0,3"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GameInfo}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding FrameworkInfo}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </DockPanel>

                <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,14,0,0" Height="44" VerticalAlignment="Bottom" SelectionChanged="Tabs_SelectionChanged">
                    <TabItem Header="Übersicht"/>
                    <TabItem Header="Abstürze"/>
                    <TabItem Header="Performance"/>
                    <TabItem Header="Mods &amp; System"/>
                    <TabItem Header="Lösungen"/>
                </TabControl>
            </Grid>
        </Border>

        <!-- ===== Inhalt ===== -->
        <Grid Grid.Row="1">

            <!-- Übersicht -->
            <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" Padding="28,22,20,22">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">
                    <!-- Spiel nicht gefunden -->
                    <Border Background="{DynamicResource Panel}" BorderBrush="#FF4D5E" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,18"
                            Visibility="{Binding GameMissing, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Content="Spielordner festlegen …" Style="{StaticResource PrimaryButton}" Click="SetGameFolder_Click" Margin="0,0,8,0"/>
                                <Button Content="Suchen" Click="SearchGame_Click"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Cyberpunk 2077 wurde nicht gefunden" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Text="Ohne Spielordner fehlen Mod-Logs, Mod-Liste und die genaue Einordnung von Abstürzen. Lege den Ordner fest, lass GameDoctor suchen – oder starte einfach das Spiel und klicke dann auf „Neu analysieren“."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Stats}" ItemTemplate="{StaticResource StatTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="Das Wichtigste" Style="{StaticResource H2}" Margin="0,26,0,10"/>
                    <ItemsControl ItemsSource="{Binding TopFindings}" ItemTemplate="{StaticResource FindingTemplate}"/>

                    <TextBlock Text="Muster über alle Abstürze" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding PatternFindings}" ItemTemplate="{StaticResource FindingTemplate}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Abstürze -->
            <Grid x:Name="CrashPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <ListBox ItemsSource="{Binding Crashes}" SelectedItem="{Binding SelectedCrash}"
                             Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0" Padding="10"
                             ItemContainerStyle="{StaticResource CrashListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Badge}" Margin="0,4,12,0" VerticalAlignment="Top"/>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Uptime}" Style="{StaticResource Muted}" FontSize="12"/>
                                            <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource Muted}">
                                            <Run Text="{Binding KindLabel, Mode=OneWay}" Foreground="{StaticResource Cyan}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Label, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,22,20,22"
                              DataContext="{Binding SelectedCrash}"
                              Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ordner öffnen" Click="OpenFolder_Click" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="Lösung ausprobieren …" Click="NewFix_Click" VerticalAlignment="Center" Margin="0,0,8,0"
                                    ToolTip="Eine Mod deaktivieren o. ä. – GameDoctor prüft danach automatisch, ob es geholfen hat"/>
                            <Button DockPanel.Dock="Right" Content="KI-Auswertung für diesen Absturz" Click="CrashPrompt_Click" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource H1}"/>
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource Muted}">
                                    <Run Text="{Binding KindLabel, Mode=OneWay}" Foreground="{StaticResource Cyan}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="18,12" Margin="0,18,0,0">
                            <ItemsControl ItemsSource="{Binding Details}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="Diagnose" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"/>

                        <StackPanel Visibility="{Binding SuspectModules, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="Nicht-Vanilla-Module auf dem Stack" Style="{StaticResource H2}"/>
                            <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="18,12">
                                <ItemsControl ItemsSource="{Binding SuspectModules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas, Segoe UI" Margin="0,3" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                       Text="Rücksprungadressen auf dem Stack des abstürzenden Threads. Ein starkes Indiz für Beteiligung, aber kein Beweis."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Performance -->
            <ScrollViewer x:Name="PerfPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22,20,22" DataContext="{Binding Perf}">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

                    <!-- PresentMon fehlt -->
                    <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="18,14" Margin="0,0,0,16"
                            Visibility="{Binding PresentMonMissing, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="PresentMon herunterladen" Style="{StaticResource PrimaryButton}" Click="DownloadPresentMon_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <StackPanel>
                                <TextBlock Text="Für die Frame-Analyse wird PresentMon benötigt" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Text="PresentMon ist ein kostenloses Open-Source-Werkzeug von Intel (ca. 1 MB). Es misst für jedes einzelne Bild, wie lange CPU und GPU daran gearbeitet haben – daraus erkennt GameDoctor den Flaschenhals. Ohne PresentMon werden nur Sensoren (CPU, GPU, Speicher) aufgezeichnet."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Steuerung -->
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Left" Content="{Binding RecordButtonText}" Style="{StaticResource PrimaryButton}" Click="Record_Click" Padding="18,9" FontSize="14"/>
                        <Button DockPanel.Dock="Right" Content="Aufnahme öffnen …" Click="OpenRecording_Click" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </DockPanel>

                    <!-- Live-Werte -->
                    <ItemsControl ItemsSource="{Binding LiveTiles}" ItemTemplate="{StaticResource StatTileTemplate}"
                                  Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Ergebnis -->
                    <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Ergebnis der letzten Aufnahme" Style="{StaticResource H2}" Margin="0,8,0,10"/>
                        <ItemsControl ItemsSource="{Binding ResultTiles}" ItemTemplate="{StaticResource StatTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Wer bremst?" Style="{StaticResource H2}"/>
                        <Border CornerRadius="5" Height="14" ClipToBounds="True" Background="{StaticResource PanelHi}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding GpuShare, Converter={StaticResource ShareToStar}}"/>
                                    <ColumnDefinition Width="{Binding CpuShare, Converter={StaticResource ShareToStar}}"/>
                                    <ColumnDefinition Width="{Binding CapShare, Converter={StaticResource ShareToStar}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#76B900"/>
                                <Border Grid.Column="1" Background="#FF9F1C"/>
                                <Border Grid.Column="2" Background="#5B9BD5"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ShareText}" Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"/>

                        <TextBlock Text="Frametime-Verlauf" Style="{StaticResource H2}"/>
                        <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <local:FrameTimeChart Height="220" Series="{Binding Series}" Stutters="{Binding Stutters}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="4,8,0,0"
                                           Text="Je niedriger und gleichmäßiger die Linie, desto flüssiger. Rote Punkte sind Ruckler. Die gestrichelten Linien markieren 60 und 30 FPS."/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding SettingsSummary}" Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12"/>

                        <TextBlock Text="Diagnose" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Lösungen -->
            <ScrollViewer x:Name="FixPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22,20,22">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">
                    <TextBlock Text="Lösungsversuche" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                               Text="Hast du eine Mod deaktiviert oder etwas geändert, prüft GameDoctor hier automatisch, ob die Absturzstelle wiederkommt. Neue Versuche startest du im Tab „Abstürze“ mit „Lösung ausprobieren …“."/>

                    <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="18,14"
                            Visibility="{Binding NoFixes, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Muted}" Text="Noch keine Lösungsversuche. Wähle im Tab „Abstürze“ einen Absturz und klicke auf „Lösung ausprobieren …“."/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Fixes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Panel}" CornerRadius="8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding StatusBrush}" CornerRadius="8,0,0,8"/>
                                        <StackPanel Grid.Column="1" Margin="16,12,16,14">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Content="Hat geholfen" Tag="{Binding Id}" Click="FixHelped_Click" Margin="0,0,6,0" Padding="10,4"/>
                                                    <Button Content="Hat nicht geholfen" Tag="{Binding Id}" Click="FixNotHelped_Click" Margin="0,0,6,0" Padding="10,4"/>
                                                    <Button Content="Entfernen" Tag="{Binding Id}" Click="FixRemove_Click" Padding="10,4"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Headline}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#C9CEDA" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"/>
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,0"
                                                         Foreground="{DynamicResource Accent}" Background="{DynamicResource PanelHi}" BorderThickness="0"
                                                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding VerdictText}" Foreground="{DynamicResource Cyan}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding VerdictText, Converter={StaticResource NullToCollapsed}}"/>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}">
                                                <Run Text="Notiz: "/><Run Text="{Binding Note, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ShareText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Mods & System -->
            <ScrollViewer x:Name="EnvPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22,20,22">
                <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Spielordner festlegen …" Click="SetGameFolder_Click" Margin="0,0,8,0"/>
                            <Button Content="MO2-Instanz festlegen …" Click="SetMo2_Click" Margin="0,0,8,0"
                                    ToolTip="Nur nötig, wenn du Mod Organizer 2 portabel nutzt und es nicht automatisch erkannt wird"/>
                            <Button Content="Suchen" Click="SearchGame_Click" Margin="0,0,8,0"/>
                            <Button Content="Automatisch erkennen" Click="ResetPaths_Click"
                                    ToolTip="Festgelegte Pfade entfernen und wieder automatisch suchen"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Datenquellen" Style="{StaticResource H2}" Margin="0,0,0,2"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Woher GameDoctor seine Daten hat – und was fehlt."/>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="18,10">
                        <ItemsControl ItemsSource="{Binding DataSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding Brush}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Detail}" Foreground="#C9CEDA" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Cyan}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="Mod-Umgebung, Hintergrundfehler und System" Style="{StaticResource H2}" Margin="0,22,0,10"/>
                    <ItemsControl ItemsSource="{Binding EnvironmentFindings}" ItemTemplate="{StaticResource FindingTemplate}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Ladeanzeige -->
            <Border Background="#D90E1016" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <TextBlock Text="Analysiere …" Style="{StaticResource H1}" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,12" Foreground="{StaticResource Accent}" Background="{StaticResource PanelHi}" BorderThickness="0"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Statuszeile ===== -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,6">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </Border>
    </Grid>
</Window>
