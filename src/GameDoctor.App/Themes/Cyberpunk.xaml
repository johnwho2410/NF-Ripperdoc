<!--
    Skin „Night City“ für Cyberpunk 2077: Neongelb und Cyan, abgeschrägte Ecken, feine Scanlines,
    schmale technische Schrift. Eigenständig gestaltet – bewusst ohne Logos, Schriften oder Grafiken
    von CD PROJEKT RED.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Farben -->
    <Color x:Key="BgColor">#0A0B0F</Color>
    <Color x:Key="PanelColor">#13151C</Color>
    <Color x:Key="PanelHiColor">#1C1F29</Color>
    <Color x:Key="LineColor">#2B2F3B</Color>
    <Color x:Key="TextColor">#ECEEF2</Color>
    <Color x:Key="MutedColor">#8A93A6</Color>
    <Color x:Key="AccentColor">#FCEE0A</Color>
    <Color x:Key="CyanColor">#00E0F0</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <!-- Fensterhintergrund mit feinen, kaum sichtbaren Scanlines -->
    <DrawingBrush x:Key="WindowBackdrop" TileMode="Tile" Stretch="None"
                  Viewport="0,0,4,3" ViewportUnits="Absolute" Viewbox="0,0,4,3" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Bg}">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,3"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0AFCEE0A">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,4,1"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelHi" Color="{StaticResource PanelHiColor}"/>
    <SolidColorBrush x:Key="PanelEdge" Color="#2E2C17"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSoft" Color="#C9CEDA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0A0B0F"/>
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="Good" Color="#4ADE80"/>
    <SolidColorBrush x:Key="RecommendBg" Color="#0F2A22"/>
    <SolidColorBrush x:Key="RecommendText" Color="#B8F5D8"/>
    <SolidColorBrush x:Key="BusyOverlay" Color="#E00A0B0F"/>
    <SolidColorBrush x:Key="ChartLine" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="EdgeAccent" Color="{StaticResource AccentColor}"/>

    <!-- Formen: eckig mit abgeschrägten Ecken -->
    <sys:Double x:Key="ShapeCorner">0</sys:Double>
    <sys:Double x:Key="ShapeCornerSmall">0</sys:Double>
    <sys:Double x:Key="ShapeChamfer">14</sys:Double>
    <sys:Double x:Key="ShapeChamferSmall">7</sys:Double>
    <sys:Double x:Key="PanelEdgeThickness">1</sys:Double>
    <CornerRadius x:Key="CornerS">0</CornerRadius>
    <CornerRadius x:Key="CornerL">0</CornerRadius>

    <!-- Schriften: Bahnschrift ist bei Windows 10/11 dabei -->
    <FontFamily x:Key="BodyFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadFont">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Segoe UI</FontFamily>
</ResourceDictionary>
