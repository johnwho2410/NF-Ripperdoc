<!--
    Skin „NF-RIPPERDOC / Night City“ für Cyberpunk 2077: dunkle, leicht bläuliche Flächen, Neongelb für Aktionen,
    Cyan für technische Informationen, sparsame abgeschrägte Ecken. Form follows function: lesbar zuerst, Dekor danach.
    Eigenständig gestaltet – bewusst ohne Logos, Schriften oder Grafiken von CD PROJEKT RED.
    Alle Farben und Maße des Designs stehen nur hier (Design-Tokens); die Oberfläche bindet sie per DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Farben (Tokens) -->
    <Color x:Key="BgColor">#0B1118</Color>          <!-- bg-primary: Hauptfenster -->
    <Color x:Key="PanelColor">#111A23</Color>       <!-- bg-secondary: Panels und Karten -->
    <Color x:Key="PanelHiColor">#172330</Color>     <!-- bg-elevated: hervorgehobene Flächen -->
    <Color x:Key="LineColor">#263747</Color>        <!-- border-default -->
    <Color x:Key="TextColor">#E6EDF5</Color>        <!-- text-primary -->
    <Color x:Key="MutedColor">#9DAFC2</Color>       <!-- text-secondary -->
    <Color x:Key="AccentColor">#FFF200</Color>      <!-- accent-primary: Primäraktionen, Fokus, aktive Navigation -->
    <Color x:Key="CyanColor">#00E5FF</Color>        <!-- accent-secondary: technische Informationen -->

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <!-- Ruhiger Fensterhintergrund, keine Scanlines -->
    <SolidColorBrush x:Key="WindowBackdrop" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelHi" Color="{StaticResource PanelHiColor}"/>
    <SolidColorBrush x:Key="PanelEdge" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSoft" Color="#C3CFDC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0B1118"/>
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="Good" Color="#20D6A0"/>                 <!-- status-success -->
    <SolidColorBrush x:Key="RecommendBg" Color="#0C1F27"/>
    <SolidColorBrush x:Key="RecommendText" Color="#9FF3EC"/>
    <SolidColorBrush x:Key="BusyOverlay" Color="#E00B1118"/>
    <SolidColorBrush x:Key="ChartLine" Color="{StaticResource CyanColor}"/>
    <!-- Halbtransparenter Hintergrund des Ingame-Overlays -->
    <SolidColorBrush x:Key="OverlayBg" Color="#D8111A23"/>
    <SolidColorBrush x:Key="EdgeAccent" Color="{StaticResource AccentColor}"/>

    <!-- Formen: eckig, nur eine kleine abgeschrägte Ecke als Markenmerkmal -->
    <sys:Double x:Key="ShapeCorner">0</sys:Double>
    <sys:Double x:Key="ShapeCornerSmall">0</sys:Double>
    <sys:Double x:Key="ShapeChamfer">10</sys:Double>
    <sys:Double x:Key="ShapeChamferSmall">5</sys:Double>
    <sys:Double x:Key="PanelEdgeThickness">1</sys:Double>
    <CornerRadius x:Key="CornerS">2</CornerRadius>
    <CornerRadius x:Key="CornerL">2</CornerRadius>

    <!-- Schriften: Inter / JetBrains Mono, falls installiert; sonst Windows-Systemschriften -->
    <FontFamily x:Key="BodyFont">Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadFont">Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
