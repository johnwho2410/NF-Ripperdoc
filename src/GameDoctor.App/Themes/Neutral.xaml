<!--
    Skin „Neutral“: ruhiges, dunkles Design ohne Spielbezug. Vorlage für weitere Skins:
    Jeder Skin muss genau dieselben Schlüssel definieren.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Farben -->
    <Color x:Key="BgColor">#111318</Color>
    <Color x:Key="PanelColor">#1A1D24</Color>
    <Color x:Key="PanelHiColor">#232732</Color>
    <Color x:Key="LineColor">#2E3340</Color>
    <Color x:Key="TextColor">#E8EAF0</Color>
    <Color x:Key="MutedColor">#8D95A8</Color>
    <Color x:Key="AccentColor">#5EA8FF</Color>
    <Color x:Key="CyanColor">#7DD3FC</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="WindowBackdrop" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelHi" Color="{StaticResource PanelHiColor}"/>
    <SolidColorBrush x:Key="PanelEdge" Color="Transparent"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSoft" Color="#C9CEDA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0B1220"/>
    <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="Good" Color="#4ADE80"/>
    <SolidColorBrush x:Key="RecommendBg" Color="#14271D"/>
    <SolidColorBrush x:Key="RecommendText" Color="#BFF0CF"/>
    <SolidColorBrush x:Key="BusyOverlay" Color="#D9111318"/>
    <SolidColorBrush x:Key="ChartLine" Color="{StaticResource AccentColor}"/>
    <!-- Halbtransparenter Hintergrund des Ingame-Overlays -->
    <SolidColorBrush x:Key="OverlayBg" Color="#D81A1D24"/>
    <!-- Farbige Kante an abgeschrägten Ecken: im neutralen Skin keine -->
    <SolidColorBrush x:Key="EdgeAccent" Color="Transparent"/>

    <!-- Formen: abgerundet, keine Schrägen -->
    <sys:Double x:Key="ShapeCorner">8</sys:Double>
    <sys:Double x:Key="ShapeCornerSmall">6</sys:Double>
    <sys:Double x:Key="ShapeChamfer">0</sys:Double>
    <sys:Double x:Key="ShapeChamferSmall">0</sys:Double>
    <sys:Double x:Key="PanelEdgeThickness">0</sys:Double>
    <CornerRadius x:Key="CornerS">5</CornerRadius>
    <CornerRadius x:Key="CornerL">8</CornerRadius>

    <!-- Schriften -->
    <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
    <FontFamily x:Key="HeadFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Segoe UI</FontFamily>
</ResourceDictionary>
