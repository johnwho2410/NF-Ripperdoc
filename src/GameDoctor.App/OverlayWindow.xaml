<Window x:Class="GameDoctor.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameDoctor.App"
        Title="{local:T 'GameDoctor Overlay'}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False"
        Foreground="{DynamicResource Text}" FontFamily="{DynamicResource BodyFont}" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Width="300">
        <!-- Kennzahlen -->
        <local:ShapeBorder x:Name="StatsPanel" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource PanelEdge}"
                           BorderThickness="{DynamicResource PanelEdgeThickness}" CornerRadius="{DynamicResource ShapeCorner}"
                           Chamfer="{DynamicResource ShapeChamferSmall}" EdgeAccent="{DynamicResource EdgeAccent}" Padding="12,8,12,10">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="BottleneckText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FpsText" Text="–" FontSize="26" FontWeight="SemiBold" FontFamily="{DynamicResource HeadFont}" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text=" FPS" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="2,0,10,5"/>
                        <TextBlock x:Name="LowText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                    </StackPanel>
                </DockPanel>
                <local:Sparkline x:Name="Spark" Height="30" Margin="0,2,0,4"/>
                <TextBlock x:Name="DetailText" Foreground="{DynamicResource TextSoft}" FontFamily="{DynamicResource MonoFont}" FontSize="11"/>
            </StackPanel>
        </local:ShapeBorder>

        <!-- Hinweise (erscheinen nur bei Problemen und verschwinden wieder) -->
        <ItemsControl x:Name="Alerts" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:ShapeBorder Background="{DynamicResource OverlayBg}" CornerRadius="{DynamicResource ShapeCornerSmall}"
                                       Chamfer="{DynamicResource ShapeChamferSmall}" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding Brush}"/>
                            <StackPanel Grid.Column="1" Margin="10,7,10,8">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontFamily="{DynamicResource HeadFont}" FontSize="13" Foreground="{Binding Brush}"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSoft}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </local:ShapeBorder>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
