<Window x:Class="GameDoctor.App.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameDoctor.App"
        Title="{local:T 'KI-Einstellungen'}"
        Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackdrop}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource PanelHi}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{local:T 'KI-Einstellungen'}" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                   Text="{local:T 'GameDoctor hat keinen eigenen KI-Zugang. Du nutzt deinen eigenen Anbieter, oder ein Modell, das lokal auf deinem PC läuft. Daten werden nur verschickt, wenn du auf „Mit KI auswerten“ klickst.'}"/>

        <TextBlock Text="{local:T 'Anbieter'}" Style="{StaticResource Label}"/>
        <Border Background="{DynamicResource Panel}" CornerRadius="{DynamicResource CornerS}" Padding="3" Margin="0,6,0,0" HorizontalAlignment="Left">
            <StackPanel x:Name="ProviderPanel" Orientation="Horizontal"/>
        </Border>
        <TextBlock x:Name="ProviderHint" Style="{StaticResource Muted}" Margin="0,8,0,0"/>

        <StackPanel x:Name="BaseUrlPanel">
            <TextBlock Text="{local:T 'Adresse der Schnittstelle'}" Style="{StaticResource Label}"/>
            <TextBox x:Name="BaseUrlBox"/>
        </StackPanel>

        <StackPanel x:Name="KeyPanel">
            <TextBlock Text="API-Key" Style="{StaticResource Label}"/>
            <PasswordBox x:Name="KeyBox"/>
            <TextBlock x:Name="KeyState" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
        </StackPanel>

        <TextBlock Text="{local:T 'Modell'}" Style="{StaticResource Label}"/>
        <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" x:Name="LoadModelsButton" Content="{local:T 'Modelle laden'}" Margin="8,0,0,0" Click="LoadModels_Click"/>
            <TextBox x:Name="ModelBox" Margin="0"/>
        </DockPanel>
        <ListBox x:Name="ModelList" MaxHeight="160" Margin="0,6,0,0" Visibility="Collapsed"
                 Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}"
                 SelectionChanged="ModelList_SelectionChanged"/>

        <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap"/>

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Left" Content="{local:T 'Verbindung testen'}" Click="Test_Click" x:Name="TestButton"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{local:T 'Abbrechen'}" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{local:T 'Speichern'}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
