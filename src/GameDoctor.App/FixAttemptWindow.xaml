<Window x:Class="GameDoctor.App.FixAttemptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lösung ausprobieren"
        Width="720" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Lösung ausprobieren" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                   Text="Wähle, was du änderst. GameDoctor beobachtet danach automatisch, ob diese Absturzstelle wiederkommt – und sagt dir, ab wann das Ergebnis belastbar ist."/>
        <TextBlock x:Name="TargetText" Margin="0,12,0,0" Foreground="{DynamicResource Cyan}" TextWrapping="Wrap"/>

        <Border Background="{DynamicResource Panel}" CornerRadius="8" Padding="18,14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Vorschläge aus der Analyse" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel x:Name="SuggestionsPanel"/>
                <TextBlock x:Name="NoSuggestions" Style="{StaticResource Muted}" Text="Für diesen Absturz gibt es keine konkreten Mod-Verdächtigen." Visibility="Collapsed" Margin="0,0,0,10"/>

                <TextBlock Text="Oder selbst auswählen" FontWeight="SemiBold" Margin="0,8,0,10"/>
                <RadioButton x:Name="RbOtherMod" GroupName="fix">
                    <StackPanel>
                        <TextBlock Text="Eine andere Mod:"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox x:Name="ActionCombo" Width="140" Margin="0,0,8,0" SelectedIndex="0">
                                <ComboBoxItem Content="deaktiviert"/>
                                <ComboBoxItem Content="aktualisiert"/>
                            </ComboBox>
                            <ComboBox x:Name="ModCombo" Width="420" IsEditable="True" IsTextSearchEnabled="True"
                                      DisplayMemberPath="DisplayName" GotFocus="ModCombo_GotFocus"/>
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RbSetting" GroupName="fix" Content="Eine Einstellung geändert / etwas anderes (z. B. Treiber, Auslagerungsdatei)"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Notiz (optional)" Margin="0,14,0,4"/>
        <TextBox x:Name="NoteBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" Padding="6"
                 Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}"/>
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                   Text="Die Notiz bleibt immer nur auf deinem PC und wird nie geteilt."/>

        <DockPanel Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Abbrechen" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Test starten" Style="{StaticResource PrimaryButton}" Click="Start_Click" IsDefault="True"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#FF4D5E" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </StackPanel>
</Window>
