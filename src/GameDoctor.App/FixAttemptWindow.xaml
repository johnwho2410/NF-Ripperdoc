<Window x:Class="GameDoctor.App.FixAttemptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameDoctor.App"
        Title="{local:T 'Lösung ausprobieren'}"
        Width="720" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{local:T 'Lösung ausprobieren'}" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                   Text="{local:T 'Wähle, was du ausprobieren möchtest. GameDoctor beobachtet danach automatisch, ob diese Absturzstelle wiederkommt – und sagt dir, ab wann das Ergebnis belastbar ist.'}"/>
        <Border Background="#2A2410" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap">
                <Run Text="{local:T 'Wichtig: '}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                <Run Text="{local:T 'GameDoctor ändert nichts an deinen Mods. Die Änderung machst du selbst – z. B. in Vortex oder Mod Organizer 2. Die Anleitung unten zeigt dir, wie.'}"/>
            </TextBlock>
        </Border>
        <TextBlock x:Name="TargetText" Margin="0,12,0,0" Foreground="{DynamicResource Cyan}" TextWrapping="Wrap"/>

        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource CornerS}" Padding="18,14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{local:T 'Vorschläge aus der Analyse'}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel x:Name="SuggestionsPanel"/>
                <TextBlock x:Name="NoSuggestions" Style="{StaticResource Muted}" Text="{local:T 'Für diesen Absturz gibt es keine konkreten Mod-Verdächtigen.'}" Visibility="Collapsed" Margin="0,0,0,10"/>

                <TextBlock Text="{local:T 'Oder selbst auswählen'}" FontWeight="SemiBold" Margin="0,8,0,10"/>
                <RadioButton x:Name="RbOtherMod" GroupName="fix" Checked="Selection_Changed">
                    <StackPanel>
                        <TextBlock Text="{local:T 'Eine andere Mod:'}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox x:Name="ActionCombo" Width="140" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="Selection_Changed">
                                <ComboBoxItem Content="{local:T 'deaktiviert'}"/>
                                <ComboBoxItem Content="{local:T 'aktualisiert'}"/>
                            </ComboBox>
                            <ComboBox x:Name="ModCombo" Width="420" IsEditable="True" IsTextSearchEnabled="True"
                                      DisplayMemberPath="DisplayName" GotFocus="ModCombo_GotFocus" SelectionChanged="Selection_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RbSetting" GroupName="fix" Checked="Selection_Changed" Content="{local:T 'Eine Einstellung geändert / etwas anderes (z. B. Treiber, Auslagerungsdatei)'}"/>
            </StackPanel>
        </Border>

        <!-- Anleitung passend zur Auswahl und zum erkannten Mod-Manager -->
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource CornerS}" Padding="18,14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="InstructionsTitle" Text="{local:T 'So geht’s'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="InstructionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#C9CEDA" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Text="{local:T 'Notiz (optional)'}" Margin="0,14,0,4"/>
        <TextBox x:Name="NoteBox" Height="56" TextWrapping="Wrap" AcceptsReturn="True" Padding="6"
                 Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}"/>
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                   Text="{local:T 'Die Notiz bleibt immer nur auf deinem PC und wird nie geteilt.'}"/>

        <DockPanel Margin="0,18,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{local:T 'Abbrechen'}" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="{local:T 'Beobachtung starten'}" Style="{StaticResource PrimaryButton}" Click="Start_Click" IsDefault="True"
                        ToolTip="{local:T 'GameDoctor merkt sich den Versuch und prüft ab jetzt, ob die Absturzstelle wiederkommt'}"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#FF4D5E" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
