<Window x:Class="GameDoctor.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KI-Auswertung"
        Width="980" Height="760" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,18,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="KI-Auswertung" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Fasst alle Befunde von GameDoctor für eine KI zusammen. Lass sie direkt hier auswerten – mit deinem eigenen Anbieter oder einem lokalen Modell – oder kopiere den Text in ChatGPT, Claude, Gemini o. ä. Benutzername, PC-Name und persönliche Pfade werden dabei entfernt."/>
            <TextBlock x:Name="FocusText" Margin="0,10,0,0" Foreground="{StaticResource Cyan}"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,14,0,10">
            <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="7" Padding="3" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ViewPrompt" Style="{StaticResource Segment}" Content="Prompt" GroupName="view" IsChecked="True" Checked="View_Checked"/>
                    <RadioButton x:Name="ViewAnswer" Style="{StaticResource Segment}" Content="Antwort der KI" GroupName="view" Checked="View_Checked"/>
                </StackPanel>
            </Border>
            <WrapPanel x:Name="OptionsPanel">
                <CheckBox x:Name="CbPatterns" Content="Muster über alle Abstürze" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="CbEnvironment" Content="Mod-Umgebung &amp; System" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="CbLogs" Content="Fehler aus Mod-Logs" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="CbModList" Content="Mod-Liste" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="CbPerf" Content="Letzte Performance-Aufnahme" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="CbAnonymize" Content="Anonymisieren" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Border x:Name="PromptPanel" Background="{StaticResource Panel}" CornerRadius="8" Padding="2">
                <TextBox x:Name="PromptBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                         Foreground="#C9CEDA" FontFamily="Consolas" FontSize="12.5" Padding="12"/>
            </Border>
            <Border x:Name="AnswerPanel" Background="{StaticResource Panel}" CornerRadius="8" Padding="2" Visibility="Collapsed">
                <TextBox x:Name="AnswerBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource Text}" FontSize="13.5" Padding="14"/>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="KI-Einstellungen …" Margin="0,0,8,0" Click="AiSettings_Click"/>
                <Button Content="Als Datei speichern …" Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="Kopieren" Margin="0,0,8,0" Click="Copy_Click"/>
                <Button x:Name="StopButton" Content="Stopp" Margin="0,0,8,0" Click="Stop_Click" Visibility="Collapsed"/>
                <Button x:Name="AskButton" Content="Mit KI auswerten" Style="{StaticResource PrimaryButton}" Click="Ask_Click"/>
            </StackPanel>
            <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
