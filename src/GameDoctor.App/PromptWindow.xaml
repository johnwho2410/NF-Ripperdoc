<Window x:Class="GameDoctor.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KI-Prompt erstellen"
        Width="980" Height="760" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,18,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="KI-Prompt erstellen" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Fasst alle Befunde von GameDoctor so zusammen, dass du sie direkt in ChatGPT, Claude, Gemini o. ä. einfügen kannst. Benutzername, PC-Name und persönliche Pfade werden dabei entfernt."/>
            <TextBlock x:Name="FocusText" Margin="0,10,0,0" Foreground="{StaticResource Cyan}"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,14,0,10">
            <CheckBox x:Name="CbPatterns" Content="Muster über alle Abstürze" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
            <CheckBox x:Name="CbEnvironment" Content="Mod-Umgebung &amp; System" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
            <CheckBox x:Name="CbLogs" Content="Fehler aus Mod-Logs" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
            <CheckBox x:Name="CbModList" Content="Mod-Liste" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
            <CheckBox x:Name="CbPerf" Content="Letzte Performance-Aufnahme" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
            <CheckBox x:Name="CbAnonymize" Content="Anonymisieren" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
        </WrapPanel>

        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="2">
            <TextBox x:Name="PromptBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                     Foreground="#C9CEDA" FontFamily="Consolas" FontSize="12.5" Padding="12"/>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Als Datei speichern …" Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="In Zwischenablage kopieren" Style="{StaticResource PrimaryButton}" Click="Copy_Click"/>
            </StackPanel>
            <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
