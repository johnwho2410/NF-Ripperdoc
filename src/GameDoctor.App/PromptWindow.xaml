<Window x:Class="GameDoctor.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameDoctor.App"
        Title="{local:T 'KI-Auswertung'}"
        Width="980" Height="760" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackdrop}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource BodyFont}" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,0,18,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{local:T 'KI-Auswertung'}" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="{local:T 'Fasst alle Befunde von GameDoctor für eine KI zusammen. Lass sie direkt hier auswerten – mit deinem eigenen Anbieter oder einem lokalen Modell – oder kopiere den Text in ChatGPT, Claude, Gemini o. ä. Benutzername, PC-Name und persönliche Pfade werden dabei entfernt.'}"/>
            <TextBlock x:Name="FocusText" Margin="0,10,0,0" Foreground="{DynamicResource Cyan}"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,14,0,10">
            <Border DockPanel.Dock="Right" Background="{DynamicResource Panel}" CornerRadius="{DynamicResource CornerS}" Padding="3" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ViewPrompt" Style="{StaticResource Segment}" Content="{local:T 'Prompt'}" GroupName="view" IsChecked="True" Checked="View_Checked"/>
                    <RadioButton x:Name="ViewAnswer" Style="{StaticResource Segment}" Content="{local:T 'Antwort der KI'}" GroupName="view" Checked="View_Checked"/>
                </StackPanel>
            </Border>
            <WrapPanel x:Name="OptionsPanel">
                <CheckBox x:Name="CbPatterns" Content="{local:T 'Muster über alle Abstürze'}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="CbEnvironment" Content="{local:T 'Mod-Umgebung &amp; System'}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="CbLogs" Content="{local:T 'Fehler aus Mod-Logs'}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="CbModList" Content="{local:T 'Mod-Liste'}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="CbPerf" Content="{local:T 'Letzte Performance-Aufnahme'}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="CbAnonymize" Content="{local:T 'Anonymisieren'}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <local:ShapeBorder x:Name="PromptPanel" Style="{StaticResource Card}" Padding="2">
                <TextBox x:Name="PromptBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextSoft}" FontFamily="{DynamicResource MonoFont}" FontSize="12.5" Padding="12"/>
            </local:ShapeBorder>
            <local:ShapeBorder x:Name="AnswerPanel" Style="{StaticResource Card}" Padding="2" Visibility="Collapsed">
                <TextBox x:Name="AnswerBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Text}" FontSize="13.5" Padding="14"/>
            </local:ShapeBorder>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{local:T 'KI-Einstellungen …'}" Margin="0,0,8,0" Click="AiSettings_Click"/>
                <Button Content="{local:T 'Als Datei speichern …'}" Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="{local:T 'Kopieren'}" Margin="0,0,8,0" Click="Copy_Click"/>
                <Button x:Name="StopButton" Content="{local:T 'Stopp'}" Margin="0,0,8,0" Click="Stop_Click" Visibility="Collapsed"/>
                <Button x:Name="AskButton" Content="{local:T 'Mit KI auswerten'}" Style="{StaticResource PrimaryButton}" Click="Ask_Click"/>
            </StackPanel>
            <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
